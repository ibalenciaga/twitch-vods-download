---

---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Twitch VOD Downloader Local</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=Martian+Mono:wdth,wght@75..112.5,400..600&display=swap"
        />
        <!-- Global so the step/file nodes built in the script get styled too. -->
        <style is:global>
            :root {
                color-scheme: dark;
                --bg: #0e1013;
                --panel: #15181d;
                --well: #1c2026;
                --line: #2a2f37;
                --ink: #e7e9ee;
                --muted: #8c94a3;
                --accent: #a48bff;
                --accent-ink: #130d26;
                --run: #f2b544;
                --ok: #4fd18b;
                --danger: #ff6b6b;
                --checker: conic-gradient(
                    #22262d 25%,
                    #191c21 0 50%,
                    #22262d 0 75%,
                    #191c21 0
                );
                --font-body: 'Archivo', 'Avenir Next', 'Segoe UI', sans-serif;
                --font-mono:
                    'Martian Mono', ui-monospace, 'SF Mono', Menlo, monospace;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: var(--font-body);
                color: var(--ink);
                background:
                    radial-gradient(
                        900px 420px at 50% -8%,
                        #1b1733 0%,
                        transparent 70%
                    ),
                    var(--bg);
                display: grid;
                justify-items: center;
                align-content: start;
                padding: 56px 24px;
            }

            .card {
                width: min(920px, 100%);
                background: var(--panel);
                border: 1px solid var(--line);
                border-radius: 14px;
                box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45);
                overflow: hidden;
            }

            .card > * {
                min-width: 0;
            }

            .head,
            .section {
                padding: 22px 26px;
            }

            .section {
                border-top: 1px solid var(--line);
            }

            .head {
                display: grid;
                gap: 14px;
            }

            .head-top {
                display: flex;
                flex-wrap: wrap;
                justify-content: space-between;
                align-items: center;
                gap: 10px 12px;
            }

            .eyebrow,
            .label {
                margin: 0;
                font-family: var(--font-mono);
                font-size: 0.66rem;
                font-weight: 500;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: var(--muted);
            }

            .label {
                margin-bottom: 12px;
            }

            h1 {
                margin: 0;
                font-size: clamp(2.1rem, 5.5vw, 3.3rem);
                font-weight: 800;
                font-stretch: 68%;
                line-height: 0.95;
                letter-spacing: -0.005em;
                text-transform: uppercase;
            }

            /* The chat is rendered with alpha, so its word is drawn without fill. */
            h1 .hollow {
                color: transparent;
                -webkit-text-stroke: 1.5px var(--accent);
            }

            .subtitle {
                margin: 0;
                max-width: 62ch;
                color: var(--muted);
                font-size: 0.95rem;
                line-height: 1.5;
            }

            .input-row {
                display: grid;
                grid-template-columns: 1fr auto auto;
                gap: 8px;
                margin-top: 6px;
            }

            input {
                width: 100%;
                padding: 13px 14px;
                border-radius: 9px;
                border: 1px solid var(--line);
                background: var(--well);
                color: var(--ink);
                font-family: var(--font-mono);
                font-size: 0.8rem;
                font-stretch: 87.5%;
            }

            input::placeholder {
                color: #5d6573;
            }

            input:focus {
                outline: none;
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(164, 139, 255, 0.22);
            }

            button {
                border: 1px solid transparent;
                padding: 12px 18px;
                border-radius: 9px;
                font-family: var(--font-body);
                font-size: 0.92rem;
                font-weight: 700;
                cursor: pointer;
                background: var(--accent);
                color: var(--accent-ink);
                transition:
                    transform 120ms ease,
                    background-color 120ms ease;
            }

            button:focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 2px;
            }

            .secondary-btn {
                background: transparent;
                color: var(--ink);
                border-color: var(--line);
            }

            .secondary-btn:not(:disabled):hover {
                background: var(--well);
            }

            button:disabled {
                opacity: 0.45;
                cursor: not-allowed;
            }

            button:not(:disabled):hover {
                transform: translateY(-1px);
            }

            .badge {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 5px 10px;
                border-radius: 999px;
                font-family: var(--font-mono);
                font-size: 0.66rem;
                font-weight: 600;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--muted);
                background: color-mix(in srgb, currentColor 12%, transparent);
                white-space: nowrap;
            }

            .badge::before {
                content: '';
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: currentColor;
            }

            .badge.running {
                color: var(--run);
            }

            .badge.running::before {
                animation: pulse 1.2s ease-in-out infinite;
            }

            .badge.done {
                color: var(--ok);
            }

            .badge.error {
                color: var(--danger);
            }

            .status-text {
                margin: 0;
                font-family: var(--font-mono);
                font-size: 0.74rem;
                color: var(--muted);
                overflow-wrap: anywhere;
            }

            .error {
                margin: 0;
                padding: 10px 12px;
                border-radius: 8px;
                border: 1px solid color-mix(in srgb, var(--danger) 40%, transparent);
                background: color-mix(in srgb, var(--danger) 10%, transparent);
                color: #ffb3b3;
                font-size: 0.88rem;
                line-height: 1.45;
                overflow-wrap: anywhere;
            }

            .steps,
            .outputs {
                display: grid;
                gap: 8px;
                padding: 0;
                margin: 0;
                list-style: none;
            }

            .steps {
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 6px;
            }

            .step {
                position: relative;
                display: grid;
                gap: 6px;
                align-content: start;
                padding: 12px 14px 15px;
                border-radius: 8px;
                border: 1px solid var(--line);
                background: var(--well);
                overflow: hidden;
            }

            .step.alpha {
                background: var(--checker);
                background-size: 14px 14px;
            }

            .step::after {
                content: '';
                position: absolute;
                inset: auto 0 0 0;
                height: 3px;
            }

            .step-top {
                display: flex;
                justify-content: space-between;
                gap: 8px;
                font-family: var(--font-mono);
                font-size: 0.64rem;
                letter-spacing: 0.04em;
                color: var(--muted);
            }

            .step-name {
                font-size: 0.95rem;
                font-weight: 600;
                line-height: 1.25;
            }

            .step-cmd {
                font-family: var(--font-mono);
                font-size: 0.66rem;
                color: var(--muted);
            }

            .step[data-status='pending'] .step-name {
                color: var(--muted);
            }

            .step[data-status='running'] {
                border-color: color-mix(in srgb, var(--run) 50%, var(--line));
            }

            .step[data-status='running'] .step-state {
                color: var(--run);
            }

            .step[data-status='running']::after {
                background: linear-gradient(
                        90deg,
                        transparent,
                        var(--run),
                        transparent
                    )
                    no-repeat;
                background-size: 50% 100%;
                animation: sweep 1.4s linear infinite;
            }

            .step[data-status='done'] {
                border-color: color-mix(in srgb, var(--ok) 40%, var(--line));
            }

            .step[data-status='done'] .step-state {
                color: var(--ok);
            }

            .step[data-status='done']::after {
                background: var(--ok);
            }

            .step[data-status='error'] {
                border-color: color-mix(in srgb, var(--danger) 55%, var(--line));
            }

            .step[data-status='error'] .step-state {
                color: var(--danger);
            }

            .step[data-status='error']::after {
                background: var(--danger);
            }

            .file {
                display: grid;
                grid-template-columns: auto minmax(0, 1fr) auto;
                align-items: center;
                gap: 14px;
                padding: 10px 12px;
                border-radius: 8px;
                border: 1px solid var(--line);
                background: var(--well);
            }

            .swatch {
                width: 44px;
                height: 28px;
                border-radius: 5px;
                border: 1px solid var(--line);
                background: linear-gradient(135deg, #2c2a40, #1a1c22);
            }

            .swatch.alpha {
                background: var(--checker);
                background-size: 8px 8px;
            }

            .file-name {
                font-weight: 600;
                font-size: 0.92rem;
            }

            .file-path {
                margin-top: 2px;
                font-family: var(--font-mono);
                font-size: 0.66rem;
                color: var(--muted);
                overflow-wrap: anywhere;
            }

            .file-kind {
                font-family: var(--font-mono);
                font-size: 0.62rem;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--muted);
            }

            .empty {
                padding: 14px;
                border-radius: 8px;
                border: 1px dashed var(--line);
                color: var(--muted);
                font-size: 0.88rem;
            }

            pre {
                margin: 0;
                max-height: 280px;
                overflow: auto;
                padding: 14px 16px;
                background: #0a0b0e;
                border: 1px solid var(--line);
                color: #c3c8d1;
                border-radius: 8px;
                font-family: var(--font-mono);
                font-size: 0.7rem;
                font-stretch: 87.5%;
                line-height: 1.65;
                white-space: pre-wrap;
                overflow-wrap: anywhere;
                word-break: break-word;
                scrollbar-color: var(--line) transparent;
            }

            @keyframes sweep {
                from {
                    background-position: -100% 0;
                }
                to {
                    background-position: 200% 0;
                }
            }

            @keyframes pulse {
                50% {
                    opacity: 0.3;
                }
            }

            @media (max-width: 640px) {
                body {
                    padding: 24px 16px;
                }

                .head,
                .section {
                    padding: 18px;
                }

                .input-row,
                .steps {
                    grid-template-columns: 1fr;
                }

                .file {
                    grid-template-columns: auto minmax(0, 1fr);
                }

                .file-kind {
                    display: none;
                }
            }

            @media (prefers-reduced-motion: reduce) {
                *,
                *::before,
                *::after {
                    animation: none !important;
                    transition: none !important;
                }
            }
        </style>
    </head>
    <body>
        <main class="card">
            <header class="head">
                <div class="head-top">
                    <p class="eyebrow">Local · TwitchDownloaderCLI + ffmpeg</p>
                    <span id="status-badge" class="badge idle">En espera</span>
                </div>
                <h1>Twitch VOD + <span class="hollow">chat</span></h1>
                <p class="subtitle">
                    Introduce una URL tipo https://www.twitch.tv/videos/2818539320
                    y la app generara VOD y chat-alpha.mov (transparente) en
                    Descargas.
                </p>

                <div class="input-row">
                    <input
                        id="vod-input"
                        placeholder="https://www.twitch.tv/videos/2818539320"
                        autocomplete="off"
                        aria-label="URL o ID del VOD"
                    />
                    <button id="run-btn">Generar Archivos</button>
                    <button id="reset-btn" class="secondary-btn" type="button">
                        Nuevo Video
                    </button>
                </div>

                <p id="status-text" class="status-text">Esperando URL.</p>
                <p id="error-text" class="error" hidden></p>
            </header>

            <section class="section">
                <div class="label">Pasos</div>
                <ol id="steps" class="steps"></ol>
            </section>

            <section class="section">
                <div class="label">Archivos generados</div>
                <ul id="outputs" class="outputs"></ul>
            </section>

            <section class="section">
                <div class="label">Logs</div>
                <pre id="logs">(sin logs)</pre>
            </section>
        </main>

        <script>
            // @ts-nocheck
            const vodInput = document.getElementById('vod-input')
            const runBtn = document.getElementById('run-btn')
            const resetBtn = document.getElementById('reset-btn')
            const statusBadge = document.getElementById('status-badge')
            const statusText = document.getElementById('status-text')
            const errorText = document.getElementById('error-text')
            const logsBox = document.getElementById('logs')
            const stepsList = document.getElementById('steps')
            const outputsList = document.getElementById('outputs')

            const STATUS_LABELS = {
                idle: 'En espera',
                running: 'Procesando',
                done: 'Listo',
                error: 'Error',
            }

            const STEP_LABELS = {
                pending: 'En cola',
                running: 'En curso',
                done: 'Hecho',
                error: 'Error',
            }

            const OUTPUT_LABELS = {
                vod: 'VOD',
                chatAlphaMov: 'Chat transparente',
            }

            // Shown before a job starts so the pipeline is visible up front.
            const DEFAULT_STEPS = [
                { name: 'Descargar VOD', command: 'videodownload', status: 'pending' },
                { name: 'Descargar chat JSON', command: 'chatdownload', status: 'pending' },
                {
                    name: 'Renderizar chat MOV transparente',
                    command: 'chatrender',
                    status: 'pending',
                },
            ]

            let currentJobId = null
            let pollTimer = null

            function el(tag, className, text) {
                const node = document.createElement(tag)
                if (className) {
                    node.className = className
                }
                if (text !== undefined) {
                    node.textContent = text
                }
                return node
            }

            function formatDuration(step) {
                if (!step.startedAt) {
                    return ''
                }

                const end = step.endedAt ? Date.parse(step.endedAt) : Date.now()
                const seconds = Math.max(
                    0,
                    Math.round((end - Date.parse(step.startedAt)) / 1000),
                )
                const minutes = Math.floor(seconds / 60)
                const rest = String(seconds % 60).padStart(2, '0')
                return minutes ? `${minutes}m ${rest}s` : `${seconds}s`
            }

            function resetUiForNextVideo() {
                if (pollTimer) {
                    window.clearTimeout(pollTimer)
                    pollTimer = null
                }

                currentJobId = null
                vodInput.value = ''
                runBtn.disabled = false
                resetBtn.disabled = false
                setStatus('idle', 'Esperando URL.')
                setError('')
                renderSteps([])
                renderOutputs(null)
                renderLogs([])
                vodInput.focus()
            }

            function setStatus(status, message) {
                statusBadge.textContent = STATUS_LABELS[status] || status
                statusBadge.className = `badge ${status}`
                statusText.textContent = message
            }

            function setError(message) {
                if (!message) {
                    errorText.hidden = true
                    errorText.textContent = ''
                    return
                }

                errorText.hidden = false
                errorText.textContent = message
            }

            function renderSteps(steps = []) {
                const list = steps.length ? steps : DEFAULT_STEPS
                stepsList.innerHTML = ''

                list.forEach((step, index) => {
                    const item = el(
                        'li',
                        step.command === 'chatrender' ? 'step alpha' : 'step',
                    )
                    item.dataset.status = step.status

                    const duration = formatDuration(step)
                    const state = STEP_LABELS[step.status] || step.status
                    const top = el('div', 'step-top')
                    top.append(
                        el('span', 'step-index', `${index + 1}/${list.length}`),
                        el(
                            'span',
                            'step-state',
                            duration ? `${state} · ${duration}` : state,
                        ),
                    )

                    item.append(
                        top,
                        el('div', 'step-name', step.name),
                        el('div', 'step-cmd', step.command),
                    )
                    stepsList.appendChild(item)
                })
            }

            function renderOutputs(outputs) {
                outputsList.innerHTML = ''
                if (!outputs) {
                    outputsList.appendChild(el('li', 'empty', 'Sin archivos aun.'))
                    return
                }

                for (const [key, value] of Object.entries(outputs)) {
                    const item = el('li', 'file')
                    const info = el('div')
                    info.append(
                        el('div', 'file-name', String(value).split('/').pop()),
                        el('div', 'file-path', value),
                    )
                    item.append(
                        el(
                            'span',
                            key === 'chatAlphaMov' ? 'swatch alpha' : 'swatch',
                        ),
                        info,
                        el('span', 'file-kind', OUTPUT_LABELS[key] || key),
                    )
                    outputsList.appendChild(item)
                }
            }

            function renderLogs(logs = []) {
                if (!logs.length) {
                    logsBox.textContent = '(sin logs)'
                    return
                }
                logsBox.textContent = logs.join('\n')
                logsBox.scrollTop = logsBox.scrollHeight
            }

            function updateFromJob(job) {
                renderSteps(job.steps)
                renderOutputs(job.outputs)
                renderLogs(job.logs)

                if (job.status === 'running') {
                    setStatus('running', `Procesando VOD ${job.vodId}...`)
                    setError('')
                    return
                }

                if (job.status === 'done') {
                    setStatus('done', `Terminado. Carpeta: ${job.outputDir}`)
                    setError('')
                    return
                }

                setStatus('error', 'El trabajo termino con error.')
                setError(job.error || 'Error desconocido.')
            }

            async function readApiJson(response) {
                const contentType = response.headers.get('content-type') || ''
                if (!contentType.includes('application/json')) {
                    const raw = await response.text()
                    const preview = raw
                        .slice(0, 160)
                        .replace(/\s+/g, ' ')
                        .trim()
                    throw new Error(
                        `La API no devolvio JSON. Respuesta: ${preview || '(vacia)'}`,
                    )
                }

                return response.json()
            }

            async function pollJob() {
                if (!currentJobId) {
                    return
                }

                try {
                    const response = await fetch(`/api/jobs/${currentJobId}`)
                    const data = await readApiJson(response)

                    if (!response.ok || !data.ok) {
                        throw new Error(
                            data.error || 'No se pudo consultar el trabajo.',
                        )
                    }

                    updateFromJob(data.job)

                    if (data.job.status === 'running') {
                        pollTimer = window.setTimeout(pollJob, 1200)
                        return
                    }

                    runBtn.disabled = false
                    resetBtn.disabled = false
                    currentJobId = null
                } catch (error) {
                    setStatus('error', 'Fallo consultando estado')
                    setError(
                        error instanceof Error ? error.message : String(error),
                    )
                    runBtn.disabled = false
                    resetBtn.disabled = false
                    currentJobId = null
                }
            }

            runBtn.addEventListener('click', async () => {
                const url = String(vodInput.value || '').trim()
                if (!url) {
                    setError('Introduce una URL o ID de VOD.')
                    return
                }

                setError('')
                setStatus('running', 'Iniciando trabajo...')
                renderSteps([])
                renderOutputs(null)
                renderLogs([])
                runBtn.disabled = true
                resetBtn.disabled = true

                if (pollTimer) {
                    window.clearTimeout(pollTimer)
                    pollTimer = null
                }

                try {
                    const response = await fetch('/api/jobs', {
                        method: 'POST',
                        headers: { 'content-type': 'application/json' },
                        body: JSON.stringify({ url }),
                    })

                    const data = await readApiJson(response)
                    if (!response.ok || !data.ok) {
                        throw new Error(
                            data.error || 'No se pudo iniciar el trabajo.',
                        )
                    }

                    currentJobId = data.job.id
                    updateFromJob(data.job)
                    pollJob()
                } catch (error) {
                    setStatus('error', 'No se pudo iniciar el trabajo')
                    setError(
                        error instanceof Error ? error.message : String(error),
                    )
                    runBtn.disabled = false
                    resetBtn.disabled = false
                }
            })

            resetBtn.addEventListener('click', () => {
                if (currentJobId) {
                    setError(
                        'Espera a que termine el trabajo actual para reiniciar.',
                    )
                    return
                }
                resetUiForNextVideo()
            })

            renderSteps([])
            renderOutputs(null)
        </script>
    </body>
</html>
